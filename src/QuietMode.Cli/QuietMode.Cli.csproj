<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>qmctl</AssemblyName>
    <RootNamespace>QuietMode.Cli</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableDefaultItems>true</EnableDefaultItems>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 产品版本跟着 QuietModeConfig.Version 走；AssemblyVersion 不动，
         这样只是「能看出这是哪一版」，不会改变程序集标识与绑定行为 -->
    <FileVersion>2.0.6.0</FileVersion>
    <ProductVersion>2.0.6</ProductVersion>
    <InformationalVersion>2.0.6</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuietMode.Core\QuietMode.Core.csproj" />
    <ProjectReference Include="..\QuietMode.Windows\QuietMode.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
